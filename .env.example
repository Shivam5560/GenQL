# The DSN that the `local` datasource row names. Registering another
# datasource means adding another variable here and pointing a row at it.
GENQL_WAREHOUSE_DSN=postgresql+psycopg://genql:genql@localhost:5433/genql
GENQL_WH2_DSN=postgresql+psycopg://genql:genql@localhost:5433/genql_wh2
GENQL_SEMANTIC_DSN=postgresql+psycopg://genql:genql@localhost:5433/genql
GENQL_DEFAULT_DATASOURCE=local
GENQL_SCOPE_RESOLVER=default
GENQL_NEO4J_URI=bolt://localhost:7687
GENQL_NEO4J_USER=neo4j
GENQL_NEO4J_PASSWORD=genqlgenql
GENQL_PROFILE_SAMPLE_LIMIT=5
# Password for the genql_readonly login role that migration 0006 provisions.
# Guarded execution connects as this role; nothing else may.
GENQL_READONLY_DB_PASSWORD=genql_readonly_dev
GENQL_QUERY_ROW_CAP=1000
GENQL_QUERY_STATEMENT_TIMEOUT_MS=30000
# Per-dimension confidence below which the ambiguity gate asks a question.
GENQL_AMBIGUITY_THRESHOLD=0.7
# Retrieval hits sampled for the domain-scoping plurality vote.
GENQL_DOMAIN_SCOPING_SAMPLE_SIZE=20
# Connection pool size for LangGraph's PostgresSaver.
GENQL_CHECKPOINT_POOL_MAX_SIZE=4
# The model used for the one escalated regeneration this phase allows.
GENQL_CHAT_MODEL_ESCALATION=anthropic/claude-opus-5
# Cap on ambiguity-driven probe queries per turn.
GENQL_PROBING_MAX_PROBES=3
# Offline synthetic ambiguity examples retrieved as few-shot context.
GENQL_AMBIGUITY_EXAMPLE_TOP_K=3
# Required only when GENQL_CHAT_PROVIDER or GENQL_EMBEDDING_PROVIDER is set
# to "openai" — calls OpenAI directly via langchain_openai instead of routing
# through OpenRouter.
GENQL_OPENAI_API_KEY=
